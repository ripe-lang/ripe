first :: fn(xs: []i32) -> i32 { return xs[0] };
main :: fn() -> i32 {
  a : [4]i32 = [7, 8, 9, 10];
  full : []i32 = a[..];
  from : []i32 = a[1..];
  to : []i32 = a[..2];
  upto : []i32 = a[..=2];
  span : []i32 = a[1..3];
  closed : []i32 = a[1..=3];
  return first(full) + from[0] + to[1] + upto[2] + span[0] + closed[0];
};
