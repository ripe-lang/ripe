func first(xs: []i32) i32 { return xs[0] }
func main() i32 {
  var a: [4]i32 = [7, 8, 9, 10]
  var full: []i32 = a[..]
  var from: []i32 = a[1..]
  var to: []i32 = a[..2]
  var upto: []i32 = a[..=2]
  var span: []i32 = a[1..3]
  var closed: []i32 = a[1..=3]
  return first(full) + from[0] + to[1] + upto[2] + span[0] + closed[0]
}
