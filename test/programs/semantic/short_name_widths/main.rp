struct pair { n: int; f: float }

func take(a: int, b: float) int {
  return a + (int(b))
}

func main() i32 {
  var p: pair = pair { n: 4, f: 2.5 }
  var sizes: i32 = sizeof(int) + sizeof(float)
  var same = i32(sizeof(int) == sizeof(i64) && sizeof(float) == sizeof(f64))
  return sizes + same + (i32(take(p.n, p.f)))
}
