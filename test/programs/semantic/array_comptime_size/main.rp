extern "C" func printf(fmt: cstr, ...) i32

var TABLE: [N]i32 = [10, 20, 30]
comptime N: i32 = 3
comptime DOUBLED: usize = sizeof([N * 2]i32)

struct box { buf: [N]i32; tail: i32 }

func main() i32 {
  var wide: [N * 2 + 1]i32 = undefined
  for i in 0..7 {
    wide[i] = i32(i)
  }
  var suffixed: [2u8]i32 = [5, 6]
  comptime local_size: i32 = N + 1
  var sized_by_local: [local_size]i32 = [1, 2, 3, 4]
  var b: box = box{ buf: TABLE, tail: 7 }
  var sum: i32 = 0
  for i in 0..N {
    sum = sum + b.buf[i]
  }
  printf("%d %d %d %d %d %d\n", TABLE[2], wide[6], suffixed[1], sized_by_local[3], sum, b.tail)
  printf("%d %d %d\n", i32(sizeof([N * 2 + 1]i32)), i32(DOUBLED), i32(sizeof(box)))
  return 0
}
