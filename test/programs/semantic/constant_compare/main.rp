// BROKEN: const eval stripped

extern "C" func printf(fmt: cstr, ...) i32

const GREATER: bool = 10 > 3
const EQUAL: bool = 5 == 5
const UNEQUAL: bool = 5 != 5
const CHAINED: bool = (2 + 2) <= 4
const FLOATCMP: bool = 1.5 < 2.5

func main() i32 {
  printf("%d %d %d %d %d\n", cast(i32, GREATER), cast(i32, EQUAL), cast(i32, UNEQUAL),
         cast(i32, CHAINED), cast(i32, FLOATCMP))
  return 0
}