extern "C" fn printf(fmt: cstr, ...) i32;

// A bare name in a pattern binds the scrutinee and catches everything
describe :: fn(n: i32) -> i32 {
  return match n {
    0 => 100,
    other => other * 2,

  };
};

main :: fn() -> i32 {
  printf("%d %d %d\n", describe(0), describe(3), describe(-4));
  return 0;
};
