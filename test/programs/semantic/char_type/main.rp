extern "C" func printf(fmt: cstr, ...) i32

func main() i32 {
  var a: char = 'A'
  var newline: char = '\n'
  var emoji: char = '😀'
  var lo: char = '\0'
  printf("%d %d %d %d\n", i32(a), i32(newline), i32(emoji), i32(lo))
  if a == 'A' { printf("eq\n") }
  if a < 'B' { printf("lt\n") }
  return i32(a)
}
