extern "C" fn printf(fmt: cstr, ...) i32;

fn main() i32 {
  total := 0;
  i := 0;
  while i < 8 {
    i += 1;
    match i % 3 {
      0 => continue,
      1 => { total += 10 }
      _ => { total += 1 }
    }
    total += 100;
  }
  last := 0;
  j := 0;
  loop {
    j += 1;
    match j % 4 {
      0 => break,
      _ => { last = j }
    }
  }
  printf("%d %d\n", total, last);
  return 0;
}
