struct pair {
  x: i32,
  y: i32,
}

fn make_pair(x: i32, y: i32) pair {
  return pair.{ x: x, y: y };
}

fn wrapper(x: i32, y: i32) pair {
  return make_pair(x, y);
}

fn sum_pair(left: pair, right: pair) i32 {
  return left.x + left.y + right.x + right.y;
}

fn main() i32 {
  return sum_pair(wrapper(1, 2), wrapper(3, 4));
}
