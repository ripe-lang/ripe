Pair :: struct {
  x: i32,
  y: i32,
};

make_pair :: fn(x: i32, y: i32) -> Pair {
  return Pair { x: x, y: y };
};

wrapper :: fn(x: i32, y: i32) -> Pair {
  return make_pair(x, y);
};

sum_pair :: fn(left: Pair, right: Pair) -> i32 {
  return left.x + left.y + right.x + right.y;
};

main :: fn() -> i32 {
  return sum_pair(wrapper(1, 2), wrapper(3, 4));
};
