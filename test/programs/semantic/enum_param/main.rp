extern "C" func printf(fmt: cstr, ...) i32

enum Level { Low; High }

func pick(level: Level, lo: i32, hi: i32) i32 {
  if level == Level.Low { return lo }
  return hi
}

func flip(level: Level) Level {
  if level == Level.Low { return Level.High }
  return Level.Low
}

func main() {
  printf("%d %d\n", pick(Level.Low, 1, 2), pick(flip(Level.Low), 1, 2))
  return
}
