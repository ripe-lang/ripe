var global: () = ();

fn pass(value: ()) () { value }

fn make() () { () }

fn number() (i32) { 4 }

fn block_value() i32 { { var x = 5; x; } }

fn explicit_return() () { return () }

fn assign() {
  var value: ();
  value = ();
  pass(value);
}

fn indirect(g: fn (()) ()) { g(global) }

fn addressable() i32 {
  var value: () = ();
  var p: *() = &value;
  var q: *() = &value;
  if p == null { return 0 }
  if p != q { return 0 }
  return 1;
}

fn main() i32 {
  var value = make();
  pass(value);
  explicit_return();
  assign();
  indirect(pass);
  return cast(i32, sizeof(())) + cast(i32, sizeof((()))) + cast(i32, sizeof(((((())))))) +
    cast(i32, sizeof((i32))) + number() + block_value() + addressable();
}
