global : () = ();

pass :: fn(value: ()) -> () { value };

make :: fn() -> () { () };

number :: fn() -> (i32) { 4 };

block_value :: fn() -> i32 { { x := 5; x; } };

explicit_return :: fn() -> () { return () };

assign :: fn() {
  value : ();
  value = ();
  pass(value);
};

indirect :: fn(g: fn (()) ()) { g(global) };

addressable :: fn() -> i32 {
  value : () = ();
  p : *() = &value;
  q : *() = &value;
  if p == null { return 0 }
  if p != q { return 0 }
  return 1;
};

main :: fn() -> i32 {
  value := make();
  pass(value);
  explicit_return();
  assign();
  indirect(pass);
  return cast(i32, sizeof(())) + cast(i32, sizeof((()))) + cast(i32, sizeof(((((())))))) +
    cast(i32, sizeof((i32))) + number() + block_value() + addressable();
};
