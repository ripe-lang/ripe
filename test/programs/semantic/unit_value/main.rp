var global: () = ()

func pass(value: ()) () { value }

func make() () { () }

func number() (i32) { 4 }

func block_value() i32 { { var x = 5; x; } }

func explicit_return() () { return () }

func assign() {
  var value: ()
  value = ()
  pass(value)
}

func indirect(fn: func (()) ()) { fn(global) }

func addressable() i32 {
  var value: () = ()
  var p: *() = &value
  var q: *() = &value
  if p == null { return 0 }
  if p != q { return 0 }
  return 1
}

func main() i32 {
  var value = make()
  pass(value)
  explicit_return()
  assign()
  indirect(pass)
  return i32(sizeof(())) + i32(sizeof((()))) + i32(sizeof(((((())))))) +
    i32(sizeof((i32))) + number() + block_value() + addressable()
}
