global : () = ();

fn pass(value: ()) () { value }

fn make() () { () }

fn number() (i32) { 4 }

fn block_value() i32 { { x := 5; x; } }

fn explicit_return() () { return () }

fn assign() {
  value : ();
  value = ();
  pass(value);
}

fn indirect(g: fn (()) ()) { g(global) }

fn addressable() i32 {
  value : () = ();
  p : *() = &value;
  q : *() = &value;
  if p == null { return 0 }
  if p != q { return 0 }
  return 1;
}

fn main() i32 {
  value := make();
  pass(value);
  explicit_return();
  assign();
  indirect(pass);
  return cast(i32, sizeof(())) + cast(i32, sizeof((()))) + cast(i32, sizeof(((((())))))) +
    cast(i32, sizeof((i32))) + number() + block_value() + addressable();
}
