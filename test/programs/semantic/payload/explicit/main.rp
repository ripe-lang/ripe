Point : type : struct { x: i32, y: i32 };
Shape : type : enum { Circle(i32), Rect(Point, i32), Empty };
Holder : type : struct { s: Shape, n: i32 };

g : Shape = Shape.Rect(Point.{1, 2}, 3);

area : (Shape) -> i32 : fn(s) {
  match s {
    Shape.Circle(r) => r * r,
    Shape.Rect(p, w) => p.x + p.y + w,
    Shape.Empty => 10,
  }
};

pick : (bool) -> Shape : fn(big) {
  if big { return Shape.Rect(Point.{4, 5}, 6) };
  Shape.Circle(2)
};

main : () -> i32 : fn {
  a : Shape = Shape.Circle(3);
  e : Shape = Shape.Empty;
  shapes : [2]Shape = [Shape.Circle(1), Shape.Empty];
  h : Holder = Holder.{ Shape.Circle(5), 1 };
  mk : (i32) -> Shape = Shape.Circle;
  area(a) + area(e) + area(g) + area(pick(true)) + area(pick(false))
    + area(shapes[0]) + area(shapes[1]) + area(h.s) + area(mk(1))
};
