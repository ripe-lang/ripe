// BROKEN: a global init can't read another global yet

SMALL : u8 = 200;
WIDE : u32 = SMALL;
GLOBAL : i64 = SMALL;

fn main() i32 {
  signed : i8 = -5;
  unsigned : u8 = 255;
  single : f32 = 2.5;

  signed_wide : i64 = signed;
  unsigned_wide : i64 = unsigned;
  double : f64 = single;
  sum := signed + unsigned_wide;
  values := [signed, unsigned_wide];
  branch := if true { signed } else { unsigned_wide };
  matched := match true { true => unsigned, false => signed_wide };
  looped := loop { if false { break signed }; break unsigned_wide };
  loop_literal := loop { if false { break 1 }; break 255u64 };
  mixed_signed : i32 = -5;
  mixed_unsigned : u32 = 10;
  mixed := mixed_signed + mixed_unsigned;

  if signed_wide != -5 { return 1 }
  if unsigned_wide != 255 { return 2 }
  if double != 2.5 { return 3 }
  if sum != 250 { return 4 }
  if values[0] != -5 || values[1] != 255 { return 5 }
  if branch != -5 { return 6 }
  if matched != 255 { return 7 }
  if looped != 255 { return 8 }
  if WIDE != 200 || GLOBAL != 200 { return 9 }
  if loop_literal != 255 { return 10 }
  if mixed != 5 { return 11 }
  return 0;
}