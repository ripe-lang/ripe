sum :: fn(xs: []i32) -> i32 {
  total : i32 = 0;
  for x in xs {
    total += x;
  }
  return total;
};

max :: fn(xs: []i32) -> i32 {
  best : i32 = xs[0];
  for x in xs {
    if x > best {
      best = x;
    }
  }
  return best;
};

main :: fn() -> i32 {
  scores : [5]i32 = [30, 10, 50, 20, 40];
  for i in 0..scores.len {
    scores[i] += 1;
  }
  total : i32 = sum(scores);
  top : i32 = max(scores);
  return total - top - 100;
};
