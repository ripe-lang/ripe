func sum(xs: []i32) i32 {
  var total: i32 = 0
  for x in xs {
    total += x
  }
  return total
}

func max(xs: []i32) i32 {
  var best: i32 = xs[0]
  for x in xs {
    if x > best {
      best = x
    }
  }
  return best
}

func main() i32 {
  var scores: [5]i32 = [30, 10, 50, 20, 40]
  for i in 0..scores.len {
    scores[i] += 1
  }
  let total: i32 = sum(scores[..])
  let top: i32 = max(scores[..])
  return total - top - 100
}
