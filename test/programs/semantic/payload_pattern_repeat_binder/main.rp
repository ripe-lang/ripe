Shape : type : enum { Circle(i32), Rect(i32, i32), Empty };
Opt :: enum { Some(Shape), None };

main :: fn -> i32 {
  s : Shape = .Rect(2, 3);
  o := Opt.Some(.Circle(4));
  a := match s { .Rect(n, n) => n, _ => 0 };
  b := match o { .Some(.Rect(x, _)) => x, .Some(.Circle(x)) => x, _ => 0 };
  c := match o { Opt.Some(Shape.Rect(y, y)) => y, _ => 0 };
  a + b + c
};
