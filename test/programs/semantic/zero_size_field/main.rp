extern "C" fn printf(fmt: cstr, ...) i32;

empty :: struct {};

sep :: struct { x: u32, u: (), e: empty, z: [0]u32, y: u32 };

padding :: struct { a: u8, u: (), b: u64 };

divres :: struct { quot: i32, u: (), e: empty, rem: i32 };

extern "C" fn div(num: i32, den: i32) divres;

main :: fn() -> i32 {
  s : sep = sep { x: 1, u: (), e: empty {}, y: 2 };
  s.y = s.y + 40;

  base : usize = cast(usize, &s.x);
  printf("%d %d %d %d %d\n", s.x, s.y,
         cast(i32, cast(usize, &s.u) - base),
         cast(i32, cast(usize, &s.z) - base),
         cast(i32, cast(usize, &s.y) - base));
  printf("%d %d %d\n", cast(i32, sizeof(sep)), cast(i32, sizeof(padding)), cast(i32, sizeof(empty)));
  printf("%d %d\n", cast(i32, sizeof(())), cast(i32, sizeof([0]u32)));

  r : divres = div(17, 5);
  printf("%d %d %d\n", r.quot, r.rem, cast(i32, sizeof(divres)));
  return 0;
};
