extern "C" func printf(fmt: cstr, ...) i32

struct empty {}

struct sep { x: u32; u: (); e: empty; z: [0]u32; y: u32 }

struct padding { a: u8; u: (); b: u64 }

struct divres { quot: i32; u: (); e: empty; rem: i32 }

extern "C" func div(num: i32, den: i32) divres

func main() i32 {
  var s: sep = sep { x: 1, u: (), e: empty {}, y: 2 }
  s.y = s.y + 40

  var base: usize = bitcast(usize) &s.x
  printf("%d %d %d %d %d\n", s.x, s.y,
         i32(bitcast(usize) &s.u - base),
         i32(bitcast(usize) &s.z - base),
         i32(bitcast(usize) &s.y - base))
  printf("%d %d %d\n", i32(sizeof(sep)), i32(sizeof(padding)), i32(sizeof(empty)))
  printf("%d %d\n", i32(sizeof(())), i32(sizeof([0]u32)))

  var r: divres = div(17, 5)
  printf("%d %d %d\n", r.quot, r.rem, i32(sizeof(divres)))

  var pu: *() = null
  var _u: () = *pu
  var pe: *empty = null
  var _e: empty = *pe
  printf("null read of a zero size type is fine\n")
  return 0
}
