write : (i32, *u8, usize) -> i64 : extern "C";

emit :: fn(s: str) -> i64 {
  return write(1, s.ptr, s.len);
};

main :: fn() -> i32 {
  emit("param\n");
  annotated : str = "annotated\n";
  write(1, annotated.ptr, annotated.len);
  first : u8 = annotated.ptr.*;
  empty : str = "";
  return cast(i32, first) - cast(i32, empty.len);
};
