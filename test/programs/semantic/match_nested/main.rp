extern "C" func printf(fmt: cstr, ...) i32

enum Shape { Dot; Line; Box }
enum Size { Small; Large }

func area(shape: Shape, size: Size) i32 {
  return match shape {
    Shape.Dot => 0
    Shape.Line => match size {
      Size.Small => 1
      Size.Large => 2

    }
    Shape.Box => match size {
      Size.Small => 10
      Size.Large => 20

    }
  }
}

func main() i32 {
  printf("%d %d %d %d\n", area(Shape.Dot, Size.Small), area(Shape.Line, Size.Large), area(Shape.Box, Size.Small), area(Shape.Box, Size.Large))
  return 0
}
