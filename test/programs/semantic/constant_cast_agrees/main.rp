// BROKEN: const eval stripped

extern "C" func printf(fmt: cstr, ...) i32
extern "C" func abs(v: i32) i32
extern "C" func atof(s: cstr) f64

const BIG: i64 = 4294967297

// A folded cast and the same cast on a runtime value must agree. The libc
// calls are opaque so the second column really is computed at run time.
func main() i32 {
  var r200: i32 = abs(-200)
  var r300: i32 = abs(-300)
  var rneg1: i32 = 0 - abs(1)
  var rbig: i64 = cast(i64, abs(-1)) * BIG
  var rf: f64 = atof("3.9")
  var rfneg: f64 = atof("-3.9")

  printf("i32->i8   %d %d\n", cast(i8, 200), cast(i8, r200))
  printf("i32->u8   %d %d\n", cast(i32, cast(u8, 300)), cast(i32, cast(u8, r300)))
  printf("neg->u8   %d %d\n", cast(i32, cast(u8, -1)), cast(i32, cast(u8, rneg1)))
  printf("neg->u32  %u %u\n", cast(u32, -1), cast(u32, rneg1))
  printf("i8->i32   %d %d\n", cast(i32, cast(i8, -1)), cast(i32, cast(i8, rneg1)))
  printf("i32->char %d %d\n", cast(i32, cast(char, 65)), cast(i32, cast(char, 65)))
  printf("neg->i64  %lld %lld\n", cast(i64, -1), cast(i64, rneg1))
  printf("i64->i32  %d %d\n", cast(i32, BIG), cast(i32, rbig))
  printf("i64->i16  %d %d\n", cast(i32, cast(i16, BIG)), cast(i32, cast(i16, rbig)))
  printf("f64->i32  %d %d\n", cast(i32, 3.9), cast(i32, rf))
  printf("negf->i32 %d %d\n", cast(i32, -3.9), cast(i32, rfneg))
  printf("f64->f32  %f %f\n", cast(f64, cast(f32, 3.9)), cast(f64, cast(f32, rf)))
  printf("f64->u8   %d %d\n", cast(i32, cast(u8, 3.9)), cast(i32, cast(u8, rf)))
  printf("i32->f64  %f %f\n", cast(f64, 200), cast(f64, r200))
  return 0
}