var PRESENT: i32 = 1;
var WRITABLE: i32 = 2;
var USER: i32 = 4;

fn has_flag(flags: i32, flag: i32) bool {
  return flags & flag != 0;
}

fn set_flag(flags: i32, flag: i32) i32 {
  return flags | flag;
}

fn clear_flag(flags: i32, flag: i32) i32 {
  return flags & ~flag;
}

fn align_up(val: i32, align: i32) i32 {
  return val + align - 1 & ~(align - 1);
}

fn main() i32 {
  var flags: i32 = 0;
  flags = set_flag(flags, PRESENT);
  flags = set_flag(flags, WRITABLE);
  flags = clear_flag(flags, WRITABLE);
  if has_flag(flags, PRESENT) { return 1 }
  return 0;
}
