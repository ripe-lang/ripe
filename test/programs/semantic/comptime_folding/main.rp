extern "C" func printf(fmt: cstr, ...) i32

comptime N: i32 = 4
comptime M: i32 = N * 2 + 1
comptime LATER: i32 = LAST - 1
comptime LAST: i32 = 100
var STORED: i32 = M + 1

struct pt { x: i32; y: i32 }
comptime SIZE: usize = sizeof(pt)

func main() i32 {
  comptime local: i32 = M * 10
  var sum: i32 = 0
  for _i in 0..N {
    comptime step: i32 = 2
    sum = sum + step
  }
  printf("%d %d %d %d %d %d %d\n", N, M, LATER, STORED, i32(SIZE), local, sum)
  if M == 9 && local == 90 && LATER == 99 {
    return 0
  }
  return 1
}
