func main() i32 {
  var a: f32 = 1.3
  var b: f32 = 1.1
  var c: f32 = 8.9

  var mul: f32 = 1.3 * 1.3
  var mix: f32 = 1.1 * 8.9
  var add: f32 = 1.3 + 1.1
  var div: f32 = 1.3 / 8.9

  if a * a != mul { return 1 }
  if b * c != mix { return 2 }
  if a + b != add { return 3 }
  if a / c != div { return 4 }

  var d: f64 = 1.3
  var wide: f64 = 1.3 * 1.3
  if d * d != wide { return 5 }

  return 0
}
