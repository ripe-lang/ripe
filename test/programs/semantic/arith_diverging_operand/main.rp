div :: fn(n: i32) -> i32 { return n / { return 1 } };
rem :: fn(n: i64) -> i64 { return n % { return 2 } };
shift :: fn(n: i32) -> i32 { return { return 3 } >> n };
compound :: fn(n: i32) -> i32 {
  x := n;
  x /= { return 4 };
  return x;
};

main :: fn() -> i32 {
  return div(9) + cast(i32, rem(9)) + shift(1) + compound(9);
};
