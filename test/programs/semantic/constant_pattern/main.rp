// BROKEN: const eval stripped

extern "C" func printf(fmt: cstr, ...) i32

const KEY: i32 = 7
const OTHER: i32 = 2 * 4

func lookup(n: i32) i32 {
  match n {
    KEY => return 100
    OTHER => return 200
    100 * 3 => return 300
    _ => return 0

  }
}

func main() i32 {
  var runtime: i32 = 7
  printf("%d %d %d %d\n", lookup(runtime), lookup(8), lookup(300), lookup(1))
  return 0
}