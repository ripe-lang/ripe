main :: fn() -> i32 {
  first := {
    p := Point { x: 3 };
    Point :: struct { x: i32 };
    p.x
  };

  second := {
    Point :: struct { x: i32, y: i32 };
    p := Point { x: 1, y: 5 };
    p.y
  };

  add :: fn(x: Coord, y: Coord) -> Coord {
    plus(x, y)
  };

  plus :: fn(x: Coord, y: Coord) -> Coord {
    x + y
  };

  count :: fn(n: Coord) -> Coord {
    if n == 0 { 0 } else { 1 + count(n - 1) }
  };

  Coord :: i32;
  offset : Coord = 4;
  return add(first + second, offset) + count(3);
};
