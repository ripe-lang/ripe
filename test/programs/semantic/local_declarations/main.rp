fn main() i32 {
  first := {
    p := Point.{ x: 3 };
    struct Point { x: i32 }
    p.x
  };

  second := {
    struct Point { x: i32, y: i32 }
    p := Point.{ x: 1, y: 5 };
    p.y
  };

  fn add(x: Coord, y: Coord) Coord {
    plus(x, y)
  }

  fn plus(x: Coord, y: Coord) Coord {
    x + y
  }

  fn count(n: Coord) Coord {
    if n == 0 { 0 } else { 1 + count(n - 1) }
  }

  type Coord = i32;
  offset : Coord = 4;
  return add(first + second, offset) + count(3);
}
