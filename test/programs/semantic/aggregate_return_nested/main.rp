Pair :: struct {
  x: i32,
  y: i32,
};

make_pair :: fn(x: i32, y: i32) -> Pair {
  return Pair { x: x, y: y };
};

merge_pair :: fn(left: Pair, right: Pair) -> Pair {
  return Pair { x: left.x + right.x, y: left.y + right.y };
};

sum_pair :: fn(left: Pair, right: Pair) -> i32 {
  return left.x + left.y + right.x + right.y;
};

main :: fn() -> i32 {
  return sum_pair(make_pair(1, 2), merge_pair(make_pair(3, 4), make_pair(5, 6)));
};
