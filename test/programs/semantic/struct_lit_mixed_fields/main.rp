// BROKEN: waiting on the new parser recovery
pair :: struct {
  x: i32,
  y: i32,
};

named_after_positional :: fn() -> pair {
  return pair { 1, y: 2 };
};

positional_after_named :: fn() -> pair {
  return pair { x: 1, 2 };
};

main :: fn() -> i32 {
  return named_after_positional().x + positional_after_named().x;
};
