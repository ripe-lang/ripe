shift :: fn(n: i32) -> i32 { return n << { return 1 } };
index :: fn(a: [2]i32) -> i32 { return a[{ return 2 }] };
convert :: fn() -> i32 { return cast(i32, { return 3 }) };
range :: fn(a: [2]i32) -> i32 {
  s := a[0..{ return 4 }];
  return cast(i32, s.len);
};
literal :: fn() -> i32 { return 1 + { return 5 } };

main :: fn() -> i32 {
  a : [2]i32 = [1, 2];
  return shift(1) + index(a) + convert() + range(a) + literal();
};
