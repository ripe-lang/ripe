struct Box { text: str, value: i32 }

G : str = "global";
M : str = "mutable";
B : Box = Box { text: "boxed", value: 7 };
E : str = "";

main :: fn() -> i32 {
  total : usize = G.len + M.len + B.text.len + E.len;
  M = "changed";
  total = total + M.len;
  return cast(i32, total + cast(usize, B.value));
};
