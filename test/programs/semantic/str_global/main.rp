struct Box { text: str, value: i32 }

var G: str = "global"
var M: str = "mutable"
var B: Box = Box { text: "boxed", value: 7 }
var E: str = ""

func main() i32 {
  var total: usize = G.len + M.len + B.text.len + E.len
  M = "changed"
  total = total + M.len
  return (total + B.value as usize) as i32
}
