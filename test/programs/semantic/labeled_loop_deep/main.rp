extern "C" fn printf(fmt: cstr, ...) i32;

fn main() i32 {
  n := 0;
  for @a i in 0..3 {
    for @b j in 0..3 {
      for k in 0..3 {
        if k == 1 { continue @b }
        if j == 2 { continue @a }
        if i == 2 { break @a }
        n += 1;
        printf("%d%d%d ", i, j, k);
      }
    }
  }
  printf("n=%d\n", n);
  return n;
}
