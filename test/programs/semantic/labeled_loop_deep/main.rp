printf : (cstr, ..) -> i32 : extern "C";

main :: fn -> i32 {
  n := 0;
  for @a i := 0..3 {
    for @b j := 0..3 {
      for k := 0..3 {
        if k == 1 { continue @b };
        if j == 2 { continue @a };
        if i == 2 { break @a };
        n += 1;
        _ := printf("%d%d%d ", i, j, k)
      }
    }
  };
  printf("n=%d\n", n);
  return n
};
