Shape : type : enum { Circle(i32), Rect(i32, i32), Empty };
Opt :: enum { Some(Shape), None };

score :: fn(o: Opt) -> i32 {
  match o {
    .Some(.Rect(w, _)) => w,
    Opt.Some(Shape.Circle(r)) => r * 10,
    .Some(_) => 1,
    .None => 0,
  }
};

main :: fn -> i32 {
  a : Opt = Opt.Some(Shape.Rect(2, 5));
  b := Opt.Some(.Circle(3));
  c : Opt = .Some(.Empty);
  d := Opt.None;
  score(a) + score(b) + score(c) + score(d)
};
