// BROKEN: const eval stripped

extern "C" func printf(fmt: cstr, ...) i32

var TABLE: [N]i32 = [10, 20, 30]
var WIDE: [N * 2]i32 = undefined

const N = 3
const M: i32 = N + 1

func main() i32 {
  for i in 0..6 {
    WIDE[i] = i32(i * 2)
  }
  printf("%d %d %d %d\n", TABLE[2], WIDE[5], N, M)
  return 0
}