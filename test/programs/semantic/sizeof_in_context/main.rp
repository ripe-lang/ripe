// BROKEN: an array size can't be sizeof yet

printf : (cstr, ..) -> i32 : extern "C";
malloc : (u64) -> ptr : extern "C";
free : (ptr) -> () : extern "C";

Pt :: struct { x: i32, y: i32 };

take :: fn(n: u8) -> i32 { return n };

main :: fn() -> i32 {
  a : u64 = sizeof(Pt);
  b : i32 = sizeof(i32);
  c : u8 = sizeof(Pt);
  d := sizeof(Pt);
  buf : [sizeof(Pt)]u8 = _;
  p := malloc(sizeof(Pt));
  free(p);
  printf("%llu %d %d %llu %d %d\n", a, b, cast(i32, c), d, cast(i32, buf.len),
    take(sizeof(i32)));
  return 0
};