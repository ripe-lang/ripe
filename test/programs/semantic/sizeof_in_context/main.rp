extern "C" func printf(fmt: cstr, ...) i32
extern "C" func malloc(n: u64) *opaque
extern "C" func free(p: *opaque)

struct pt { x: i32, y: i32 }

func take(n: u8) i32 { return n }

func main() i32 {
  var a: u64 = sizeof(pt)
  var b: i32 = sizeof(i32)
  var c: u8 = sizeof(pt)
  var d = sizeof(pt)
  var buf: [sizeof(pt)]u8 = undefined
  var p = malloc(sizeof(pt))
  free(p)
  printf("%llu %d %d %llu %d %d\n", a, b, i32(c), d, i32(buf.len),
    take(sizeof(i32)))
  return 0
}
