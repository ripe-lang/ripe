// BROKEN: an array size can't be sizeof yet

extern "C" fn printf(fmt: cstr, ...) i32;
extern "C" fn malloc(n: u64) ptr;
extern "C" fn free(p: ptr);

struct pt { x: i32, y: i32 }

fn take(n: u8) i32 { return n }

fn main() i32 {
  var a: u64 = sizeof(pt);
  var b: i32 = sizeof(i32);
  var c: u8 = sizeof(pt);
  var d = sizeof(pt);
  var buf: [sizeof(pt)]u8;
  var p = malloc(sizeof(pt));
  free(p);
  printf("%llu %d %d %llu %d %d\n", a, b, cast(i32, c), d, cast(i32, buf.len),
    take(sizeof(i32)));
  return 0;
}