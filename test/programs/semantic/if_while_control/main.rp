fn abs(n: i32) i32 {
  if n < 0 { return -n }
  return n;
}

fn sign(n: i32) i32 {
  if n < 0 { return -1 } else if n > 0 { return 1 } else { return 0 }
}

fn sum_to(n: i32) i32 {
  total : i32 = 0;
  i : i32 = 1;
  while i <= n {
    total += i;
    i += 1;
  }
  return total;
}

fn main() i32 {
  a : i32 = abs(-7);
  s : i32 = sign(3);
  t : i32 = sum_to(10);
  return t;
}
