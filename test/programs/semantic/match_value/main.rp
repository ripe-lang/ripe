extern "C" func printf(fmt: cstr, ...) i32

enum Size { Small, Large }

func main() {
  let width = match Size.Large {
    Size.Small => 10,
    Size.Large => 20,
  }
  var height = match Size.Small {
    Size.Small => 1,
    Size.Large => 2,
  }
  height += match Size.Large {
    Size.Small => 0,
    Size.Large => 5,
  }
  printf("%d %d\n", width, height)
  return
}
