printf : (cstr, ..) -> i32 : extern "C";

main :: fn() -> i32 {
  inner := 0;
  outer := 0;
  for _i := 0..3 {
    for j := 0..3 {
      printf("%d", if j == 1 { continue } else { j });
      inner += 1;
    }
    printf("|");
    outer += 1;
  }

  skipped := 0;
  for i := 0..4 {
    for j := 0..2 {
      skipped += j;
    }
    printf("%d", if i == 2 { continue } else { i });
    outer += 1;
  }

  printf(" inner=%d outer=%d skipped=%d\n", inner, outer, skipped);
  return 0;
};
