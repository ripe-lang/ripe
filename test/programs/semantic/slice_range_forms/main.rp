extern "C" func printf(fmt: cstr, ...) i32

func sum(s: []i32) i32 {
  var t: i32 = 0
  for i in 0..s.len { t += s[i] }
  return t
}

func main() i32 {
  var a: [4]i32 = [1, 2, 4, 8]

  printf("%d %d\n", a[..].len as i32, sum(a[..]))
  printf("%d %d\n", a[1..].len as i32, sum(a[1..]))
  printf("%d %d\n", a[..2].len as i32, sum(a[..2]))
  printf("%d %d\n", a[..=2].len as i32, sum(a[..=2]))
  printf("%d %d\n", a[1..3].len as i32, sum(a[1..3]))
  printf("%d %d\n", a[1..=2].len as i32, sum(a[1..=2]))

  // The whole array spelled four ways
  printf("%d %d %d %d\n", sum(a[..]), sum(a[0..]), sum(a[..4]), sum(a[..=3]))

  // A slice can be resliced with the same forms
  var s: []i32 = a[..]
  printf("%d %d %d\n", sum(s[..]), sum(s[2..]), sum(s[..=1]))

  return sum(a[..])
}
