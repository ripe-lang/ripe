func sum(xs: []i32) i32 {
  var total: i32 = 0
  for x in xs {
    total += x
  }
  return total
}

func main() i32 {
  var a: [5]i32 = [1, 2, 3, 4, 5]
  a[0] = 10
  var doubled: i32 = 0
  for i in 0..a.len {
    doubled += a[i] * 2
  }
  var whole: i32 = sum(a[..])
  var middle: i32 = sum(a[1..4])
  return doubled + whole + middle - 47
}
