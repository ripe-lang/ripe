printf : (cstr, ..) -> i32 : extern "C";
qsort : (*i32, usize, usize, extern "C" (*i32, *i32) -> i32) -> () : extern "C";

main :: fn {
  xs : [4]i32 = [3, 1, 4, 2];
  cmp : extern "C" (*i32, *i32) -> i32 = extern "C" fn(a, b) { a.* - b.* };
  qsort(&xs[0], 4, 4, cmp);
  printf("%d %d %d %d\n", xs[0], xs[1], xs[2], xs[3]);
};
