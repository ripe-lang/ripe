main :: fn() -> i32 {
  first :: fn(value: i32) -> i32 {
    second :: fn(value: i32) -> i32 {
      third :: fn(value: i32) -> i32 {
        fourth :: fn(value: i32) -> i32 {
          value + 1
        };

        fourth(value)
      };

      third(value)
    };

    second(value)
  };

  return first(14);
};
