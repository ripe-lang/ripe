// BROKEN: const eval stripped

extern "C" func printf(fmt: cstr, ...) i32

const LIMIT: i32 = 42

// A name standing for a const compares, any other bare name binds
func check(x: i32) i32 {
  return match x {
    LIMIT => 1
    other => other

  }
}

func main() i32 {
  const LOCAL: i32 = 9
  var n = match 9 {
    LOCAL => 100
    _ => 0

  }
  printf("%d %d %d\n", check(42), check(7), n)
  return 0
}