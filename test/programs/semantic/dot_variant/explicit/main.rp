Color : type : enum { Red, Green, Blue };

paint : (Color) -> i32 : fn(c) => if c == Color.Blue { 4 } else { 1 };
pick : () -> Color : fn() => { return Color.Green };

main : () -> i32 : fn() => {
  c : Color = Color.Green;
  cs : [2]Color = [Color.Red, Color.Blue];
  n : i32 = match c {
    Color.Red => 1,
    Color.Green => 10,
    Color.Blue => 100,
  };
  same : i32 = if Color.Green == c { 1 } else { 0 };
  n + paint(Color.Blue) + paint(cs[1]) + same + (if pick() == Color.Green { 1 } else { 0 })
};
