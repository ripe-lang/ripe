extern "C" fn printf(fmt: cstr, ...) i32;

Level :: enum { Low, Mid, High };

announce :: fn(level: Level) {
  match level {
    Level.Low => { printf("low\n") }
    Level.Mid => { printf("mid\n") }
    Level.High => { printf("high\n") }
  }
  return;
};

main :: fn() -> i32 {
  announce(Level.Mid);
  announce(Level.High);
  announce(Level.Low);
  return 0;
};
