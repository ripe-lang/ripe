Point :: struct { x: i32, y: i32 };
Wide :: struct { a: i64, b: i64 };
Big :: struct { a: i64, b: i64, c: i64 };
Vec2 :: struct { x: f32, y: f32 };
Mixed :: struct { n: i32, f: f64 };
Held :: struct { v: [4]i32 };

extern "C" fn shift(p: Point, d: i32) Point {
  return Point{x: p.x + d, y: p.y + d};
}

extern "C" fn widen(w: Wide) Wide {
  return Wide{a: w.a * 2, b: w.b * 2};
}

extern "C" fn grow(b: Big, d: i64) Big {
  return Big{a: b.a + d, b: b.b + d, c: b.c + d};
}

extern "C" fn scale(v: Vec2, k: f32) Vec2 {
  return Vec2{x: v.x * k, y: v.y * k};
}

extern "C" fn blend(m: Mixed) Mixed {
  return Mixed{n: m.n + 1, f: m.f + 0.5};
}

extern "C" fn total(h: Held) i32 {
  sum : i32 = 0;
  for i in 0..4 {
    sum = sum + h.v[i];
  }
  return sum;
}

extern "C" fn bump(w: *Wide) {
  w.a = w.a + 1;
  w.b = w.b + 1;
}
