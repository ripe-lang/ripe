import std.io;

extern "C" fn not_defined_anywhere() i32;

fn never_called() i32 {
  return not_defined_anywhere();
}

fn through_pointer() {
  io.print("through pointer");
}

fn through_global() {
  io.print("through global");
}

var unused_handler: fn() i32 = never_called;
var handler: fn() = through_global;

fn main() i32 {
  var f: fn() = through_pointer;
  f();
  handler();
  return 0;
}
