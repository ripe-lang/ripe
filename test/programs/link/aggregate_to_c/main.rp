extern "C" fn printf(fmt: cstr, ...) i32;

struct Point { x: i32, y: i32 }
struct Wide { a: i64, b: i64 }
struct Big { a: i64, b: i64, c: i64 }
struct Pair { x: f64, y: f64 }
struct Mixed { n: i32, f: f64 }

extern "C" fn c_shift(p: Point, d: i32) Point;
extern "C" fn c_widen(w: Wide) Wide;
extern "C" fn c_grow(b: Big, d: i64) Big;
extern "C" fn c_scale(p: Pair, k: f64) Pair;
extern "C" fn c_blend(m: Mixed) Mixed;
extern "C" fn c_bump(w: *Wide);

fn main() i32 {
  var p: Point = c_shift(Point{x: 10, y: 20}, 5);
  printf("point %ld %ld\n", cast(i64, p.x), cast(i64, p.y));

  var w: Wide = c_widen(Wide{a: 100, b: 200});
  printf("wide %ld %ld\n", w.a, w.b);

  var b: Big = c_grow(Big{a: 1, b: 2, c: 3}, 10);
  printf("big %ld %ld %ld\n", b.a, b.b, b.c);

  var f: Pair = c_scale(Pair{x: 1.5, y: 2.5}, 4.0);
  printf("pair %ld %ld\n", cast(i64, f.x), cast(i64, f.y));

  var m: Mixed = c_blend(Mixed{n: 7, f: 0.25});
  printf("mixed %ld %ld\n", cast(i64, m.n), cast(i64, m.f * 100.0));

  var own: Wide = Wide{a: 41, b: 51};
  c_bump(&own);
  printf("bump %ld %ld\n", own.a, own.b);
  return 0;
}
