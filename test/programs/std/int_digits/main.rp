import std.io

func show(value: i64) {
  io.print_int_raw(value)
  io.print_raw("|")
}

func main() i32 {
  show(0)
  show(9)
  show(10)
  show(99)
  show(100)
  io.print_line()

  show(-1)
  show(-9)
  show(-10)
  show(-99)
  show(-100)
  io.print_line()

  io.print_raw("")
  io.print_int_raw(1234567890)
  io.print_line()
  return 0
}
