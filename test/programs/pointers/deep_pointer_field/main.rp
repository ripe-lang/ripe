extern "C" fn printf(fmt: cstr, ...) i32;

Point :: struct { x: i32, y: i32 };

main :: fn() -> i32 {
  p : Point = Point { x: 42, y: 7 };
  q : *Point = &p;
  qq : **Point = &q;
  qqq : ***Point = &qq;

  printf("%d %d %d\n", q.x, (*qq).x, (**qqq).x);

  q.x = 1;
  (*qq).y = 2;
  printf("%d %d\n", p.x, p.y);

  (**qqq).x = 3;
  (**qqq).y = 9;
  printf("%d %d\n", p.x, p.y);
  return 0;
};
