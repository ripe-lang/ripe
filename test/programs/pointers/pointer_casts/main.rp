extern "C" fn printf(fmt: cstr, ...) i32;
extern "C" fn malloc(n: usize) ptr;

Point :: struct { x: i32, y: i32 };

BinOp :: (fn (i32, i32) i32);

add :: fn(a: i32, b: i32) -> i32 { return a + b };

main :: fn() -> i32 {
  raw : ptr = malloc(sizeof(Point));
  p : *Point = cast(*Point, raw);
  p.x = 40;
  p.y = 2;

  address : usize = cast(usize, p);
  back : *Point = cast(*Point, address);
  wide : u64 = cast(u64, p);
  signed : isize = cast(isize, p);

  bytes : *u8 = cast(*u8, p);
  deep : **u8 = cast(**u8, p);
  rows : *[2]i32 = cast(*[2]i32, p);
  fp : *BinOp = cast(*BinOp, p);
  indirect : *fn (i32, i32) i32 = cast(*fn (i32, i32) i32, p);
  erased : ptr = cast(ptr, p);

  op : BinOp = add;
  call_through : *BinOp = &op;

  printf("%d %d %d\n", back.x, back.y, cast(i32, *bytes));
  printf("%d %d %d\n", cast(i32, cast(usize, deep) - address), cast(i32, wide - cast(u64, address)),
         cast(i32, cast(usize, signed) - address));
  printf("%d %d\n", (*rows)[0], (*rows)[1]);
  printf("%d %d\n", cast(i32, cast(usize, fp) - address), cast(i32, cast(usize, indirect) - address));
  printf("%d %d\n", cast(i32, cast(usize, erased) - address), (*call_through)(1, 2));
  return back.x + back.y;
};
