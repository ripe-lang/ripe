point :: struct { x: i32, y: i32 };

deref_sum :: fn(a: *i32, b: *i32) -> i32 {
  return *a + *b;
};

deref_negate :: fn(p: *i32) -> i32 {
  return -*p;
};

bump :: fn(p: *point) {
  p.x += 1;
};

main :: fn() -> i32 {
  x : i32 = 10;
  y : i32 = 32;
  sum := deref_sum(&x, &y);
  neg := deref_negate(&x);
  p : point = point { x: 0, y: 0 };
  bump(&p);
  bump(&p);
  return sum + neg + p.x;
};
