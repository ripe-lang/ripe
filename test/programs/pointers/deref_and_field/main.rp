struct point { x: i32, y: i32 }

fn deref_sum(a: *i32, b: *i32) i32 {
  return *a + *b;
}

fn deref_negate(p: *i32) i32 {
  return -*p;
}

fn bump(p: *point) {
  p.x += 1;
}

fn main() i32 {
  x : i32 = 10;
  y : i32 = 32;
  sum := deref_sum(&x, &y);
  neg := deref_negate(&x);
  p : point = point.{ x: 0, y: 0 };
  bump(&p);
  bump(&p);
  return sum + neg + p.x;
}
