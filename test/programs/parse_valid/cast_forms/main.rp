h :: fn(a: i32) -> i32 { return a };
pt :: struct { x: i32, y: i32 };
word :: i32;
main :: fn() -> i32 {
  n : i32 = cast(i32, cast(u32, 3));
  m : u32 = 3;
  w : i32 = cast(i32, m);
  b : u8 = cast(u8, 300);
  f : f64 = cast(f64, 3);
  c : char = cast(char, 65);
  a : word = cast(word, 1);
  p : *i32 = &n;
  q : *u32 = cast(*u32, p);
  pp : **i32 = &p;
  qq : **u32 = cast(**u32, pp);
  o : ptr = cast(ptr, p);
  z : *i32 = cast(*i32, cast(usize, 0));
  fp : fn (i32) i32 = h;
  ep : extern "C" fn (i32) i32 = cast(extern "C" fn (i32) i32, fp);
  hp : *fn (i32) i32 = &fp;
  if cast(usize, p) == 0 { return 1 }
  if z != null { return 2 }
  scalars : i32 = n + w + cast(i32, b) + cast(i32, f) + cast(i32, c) + a + cast(i32, true);
  reads : i32 = cast(i32, *q) + cast(i32, **qq) + *cast(*i32, o);
  calls : i32 = fp(1) + (fp)(1) + (*hp)(1) + ep(1);
  return scalars + reads + calls;
};
