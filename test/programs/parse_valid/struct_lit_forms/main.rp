Point :: struct { x: i32, y: i32 };
Line :: struct { a: Point, b: Point };
Empty :: struct { };
take :: fn(p: Point) -> i32 { return p.x };
main :: fn() -> i32 {
  a := Point.{ x: 1, y: 2 };
  b := Point.{ 3, 4, };
  _e := Empty.{ };
  l := Line.{ Point.{ 5, 6 }, Point . { 7, 8 } };
  return a.y + b.x + l.b.x + Point.{ 1, 9 }.y + take(Point.{ 10, 0 });
};
