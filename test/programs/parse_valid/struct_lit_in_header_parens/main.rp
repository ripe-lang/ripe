Point :: struct { x: i32, y: i32 };
main :: fn() -> i32 {
  n : i32 = 0;
  if (Point { x: 5, y: 4 }).x > 2 { n = 1 }
  while n < (Point { x: 3, y: 0 }).x { n = n + 1 }
  for i in 0..(Point { x: 2, y: 0 }).x { n = n + i }
  loop @outer {
    n = n + (Point { x: 1, y: 0 }).x;
    break @outer;
  }
  return match (Point { x: 1, y: 2 }).y { 2 => n, _ => 0 };
};
