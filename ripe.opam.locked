opam-version: "2.0"
name: "ripe"
version: "dev"
synopsis: "Ripe compiler and language tooling"
description:
  "Ripe is a systems programming language with an OCaml compiler and QBE backend."
maintainer: "Ripe contributors"
authors: "Ripe contributors"
license: "Apache-2.0"
tags: ["compiler" "language" "systems" "qbe"]
homepage: "https://github.com/ripe-lang/ripe"
doc: "https://github.com/ripe-lang/ripe#readme"
bug-reports: "https://github.com/ripe-lang/ripe/issues"
depends: [
  "astring" {= "0.8.5" & with-dev-setup}
  "base" {= "v0.17.3" & with-test}
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "camlp-streams" {= "5.0.1" & with-dev-setup}
  "climate" {= "0.9.0"}
  "cmdliner" {= "2.1.1" & with-dev-setup}
  "compiler-cloning" {= "enabled"}
  "cppo" {= "1.8.0"}
  "csexp" {= "1.5.2"}
  "dune" {= "3.24.2"}
  "dune-build-info" {= "3.24.2" & with-dev-setup}
  "dune-configurator" {= "3.24.2" & with-test}
  "dune-private-libs" {= "3.24.2"}
  "dune-site" {= "3.24.2"}
  "dyn" {= "3.24.2"}
  "either" {= "1.0.0" & with-dev-setup}
  "fix" {= "20250919" & with-dev-setup}
  "fpath" {= "0.7.3" & with-dev-setup}
  "fs-io" {= "3.24.2"}
  "jane-street-headers" {= "v0.17.0" & with-test}
  "jst-config" {= "v0.17.0" & with-test}
  "menhir" {= "20260209" & with-dev-setup}
  "menhirCST" {= "20260209" & with-dev-setup}
  "menhirGLR" {= "20260209" & with-dev-setup}
  "menhirLib" {= "20260209" & with-dev-setup}
  "menhirSdk" {= "20260209" & with-dev-setup}
  "ocaml" {= "5.5.1"}
  "ocaml-base-compiler" {= "5.5.1"}
  "ocaml-compiler" {= "5.5.1"}
  "ocaml-compiler-libs" {= "v0.17.0"}
  "ocaml-options-vanilla" {= "1"}
  "ocaml-version" {= "4.1.4" & with-dev-setup}
  "ocaml_intrinsics_kernel" {= "v0.17.2" & with-test}
  "ocamlbuild" {= "0.16.1" & with-dev-setup}
  "ocamlfind" {= "1.9.9~preview"}
  "ocamlformat" {= "0.29.0" & with-dev-setup}
  "ocamlformat-lib" {= "0.29.0" & with-dev-setup}
  "ocp-indent" {= "1.10.0" & with-dev-setup}
  "ordering" {= "3.24.2"}
  "pp" {= "2.0.0"}
  "ppx_assert" {= "v0.17.0" & with-test}
  "ppx_base" {= "v0.17.0" & with-test}
  "ppx_cold" {= "v0.17.0" & with-test}
  "ppx_compare" {= "v0.17.0" & with-test}
  "ppx_derivers" {= "1.2.1"}
  "ppx_deriving" {= "6.2.0"}
  "ppx_enumerate" {= "v0.17.0" & with-test}
  "ppx_expect" {= "v0.17.3" & with-test}
  "ppx_globalize" {= "v0.17.2" & with-test}
  "ppx_hash" {= "v0.17.0" & with-test}
  "ppx_here" {= "v0.17.0" & with-test}
  "ppx_inline_test" {= "v0.17.1" & with-test}
  "ppx_optcomp" {= "v0.17.1" & with-test}
  "ppx_sexp_conv" {= "v0.17.1" & with-test}
  "ppxlib" {= "0.38.0"}
  "ppxlib_jane" {= "v0.17.4" & with-test}
  "re" {= "1.14.0" & with-dev-setup}
  "sexplib0" {= "v0.17.0"}
  "stdio" {= "v0.17.0" & with-test}
  "stdlib-shims" {= "0.3.0"}
  "stdune" {= "3.24.2"}
  "time_now" {= "v0.17.0" & with-test}
  "top-closure" {= "3.24.2"}
  "topkg" {= "1.1.1" & with-dev-setup}
  "uucp" {= "18.0.0" & with-dev-setup}
  "uuseg" {= "18.0.0" & with-dev-setup}
  "uutf" {= "1.0.4" & with-dev-setup}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "--promote-install-files=false"
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
  ["dune" "install" "-p" name "--create-install-files" name]
]
dev-repo: "git+https://github.com/ripe-lang/ripe.git"
x-maintenance-intent: ["(latest)"]