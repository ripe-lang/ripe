func abs(n: i32) i32 {
  if n < 0 { return -n }
  return n
}

func sign(n: i32) i32 {
  if n < 0 { return -1 }
  elseif n > 0 { return 1 }
  else { return 0 }
}

func sum_to(n: i32) i32 {
  var total: i32 = 0
  var i: i32 = 1
  while i <= n {
    total += i
    i += 1
  }
  return total
}

func main() {
  const a: i32 = abs(-7)
  const s: i32 = sign(3)
  const t: i32 = sum_to(10)
  return t
}
