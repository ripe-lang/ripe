// Multi-dimensional (nested) fixed arrays and nested iteration.
func main() i32 {
  // A 3x3 grid, indexed as grid[row][col].
  var grid: [3][3]i32 = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9],
  ]

  // Sum the main diagonal: 1 + 5 + 9 = 15.
  var diagonal: i32 = 0
  for i in 0..3 {
    diagonal += grid[i][i]
  }

  // Write through a nested index.
  grid[2][2] = 100

  return diagonal + grid[2][2] - 100   // 15 + 100 - 100 = 15
}
