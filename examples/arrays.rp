# Arrays: fixed [N]T, slices []T, and iteration.

# Slices are fat pointers, so one function works on any array length.
func sum(xs: []i32) i32 {
  var total: i32 = 0
  for x in xs {
    total += x
  }
  return total
}

func main() i32 {
  # Fixed array: stack allocated, size known at compile time.
  var a: [5]i32 = [1, 2, 3, 4, 5]

  # Index assignment.
  a[0] = 10

  # for over a range.
  var doubled: i32 = 0
  for i in 0..a.len as i32 {
    doubled += a[i] * 2
  }

  # [5]i32 coerces to []i32, and a[1..4] borrows a sub-slice.
  const whole: i32 = sum(a)         # 10 + 2 + 3 + 4 + 5 = 24
  const middle: i32 = sum(a[1..4])  # 2 + 3 + 4 = 9

  # doubled = 2*(10+2+3+4+5) = 48
  return doubled + whole + middle - 47   # 48 + 24 + 9 - 47 = 34
}
