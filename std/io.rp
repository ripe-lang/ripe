module io

extern "C" func printf(fmt: cstr, ...) i32
extern "C" func putchar(c: i32) i32

pub func print(s: cstr) {
  printf("%s", s)
}

pub func println(s: cstr) {
  printf("%s\n", s)
}

pub func print_int(n: int) {
  printf("%lld", n)
}

// TODO(3ab7): A char holds a full scalar so anything past 0x7F truncates here
pub func print_char(c: char) {
  putchar(c as i32)
}
